# Build output
/build/

# Local deployment directory: the build fills it in. The starter script is the
# one file here that is written by hand, so it stays tracked.
/bin/*
!/bin/start-cha.sh

# Browser build and test output
/src/resources/webapp/node_modules/
/src/resources/webapp/dist/
/src/resources/webapp/test-results/
/src/resources/webapp/playwright-report/

# In-source CMake artifacts
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CPack*.cmake

# Editor / swap files
*.swp
*~

.env
*.sqlite3
*.log
*.cha-lock

# Local backups
*.bac

# Claude Code machine-local settings
/.claude/settings.local.json
