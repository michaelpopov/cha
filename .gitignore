# Build output
/.vscode/
/build/
/Testing/
/test-results/
/graphify-out/

# Local deployment directory: the build fills it in. The starter script is the
# one file here that is written by hand, so it stays tracked.
/bin/*
!/bin/start-cha.sh
!/bin/start-cha.bat

# Browser build and test output
/webapp/node_modules/
/webapp/dist/
/webapp/test-results/
/webapp/playwright-report/

# Reproducible customer application directories
/packages/

# In-source CMake artifacts
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CPack*.cmake

# Editor / swap files
*.swp
*~

.env
!/packaging/linux/import-seed/.env
*.sqlite3
*.log
*.cha-lock

# Local backups
*.bac

# Claude Code machine-local settings
/.claude/settings.local.json
