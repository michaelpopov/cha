# Build output
/.vscode/
/build/
/Testing/
/test-results/
/graphify-out/

# Local deployment directory: the build fills it in. The starter script is the
# one file here that is written by hand, so it stays tracked.
/bin/*
!/bin/start-cha.sh
!/bin/start-cha.bat

# Browser build and test output
/webapp/node_modules/
/webapp/dist/
/webapp/test-results/
/webapp/playwright-report/

# Reproducible customer application directories
/packages/

# In-source CMake artifacts
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CPack*.cmake

# Editor / swap files
*.swp
*~

# macOS Finder metadata
.DS_Store

.env
!/packaging/linux/import-seed/.env
openai-auth.json
*.sqlite3
*.openai-auth.json
*.log
*.cha-lock

# Development configuration directory: track only the app file and the Dev vault.
/cha-config/*
!/cha-config/app.toml
!/cha-config/dev.toml

# Local backups
*.bac

# Claude Code machine-local settings
/.claude/settings.local.json
