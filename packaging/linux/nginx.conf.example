# Example nginx routing for cha-daemon. Replace the map values with
# lowercase hex API keys from `openssl rand -hex 32`.

map_hash_bucket_size 128;

map $http_authorization $cha_user {
    "Bearer <alice-key>"  alice;
    "Bearer <bob-key>"    bob;
    default               "";
}

server {
    listen 443 ssl;
    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    location /v1/ {
        if ($cha_user = "") { return 401; }
        client_max_body_size      16m;
        include                   scgi_params;
        scgi_pass                 unix:/run/cha/$cha_user.sock;
        scgi_pass_request_headers off;
        scgi_buffering            off;
        scgi_read_timeout         3600s;
        scgi_send_timeout         3600s;
    }
}
