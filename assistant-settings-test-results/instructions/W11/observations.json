          "transcript": [
            {
              "id": 1,
              "request_id": 1,
              "created_at": 1793596149,
              "web_search_used": false,
              "addressed_to": "builtin-assistant",
              "display_name": "Guest",
              "input_tokens": null,
              "text": "Explain how Writer can search Docs OpenAI and Docs Gemini.",
              "output_tokens": null,
              "participant_id": "builtin-guest",
              "kind": "human",
